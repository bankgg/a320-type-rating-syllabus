 "background": [
  {
   "text": "Each ADIRS has two parts (ADR and IRS) that may fail independently. A single NAV ADR FAULT only requires action on the switching panel as indicated by the ECAM.",
   "applies_to": [
    "all"
   ],
   "refs": [
    {
     "book": "FCTM",
     "code": "PR-AEP-NAV",
     "page": "P 1/20",
     "pdf": 478
    }
   ]
  },
  {
   "text": "AIR DATA selector: NORM — ADIRU 1 to the captain side, ADIRU 2 to the F/O side. CAPT 3 — ADR 3 replaces ADR 1. F/O 3 — ADR 3 replaces ADR 2.",
   "applies_to": [
    "all"
   ],
   "refs": [
    {
     "book": "FCOM",
     "code": "DSC-34-NAV-10-20",
     "page": "P 3/6",
     "pdf": 2102
    }
   ]
  },
  {
   "text": "ADR pb-sw FAULT light: ADR failed (NAV ADR FAULT alert). Pressing it turns the ADR off and the FAULT light goes off.",
   "applies_to": [
    "all"
   ],
   "refs": [
    {
     "book": "FCOM",
     "code": "DSC-34-NAV-10-20",
     "page": "P 3/6",
     "pdf": 2102
    }
   ]
  }
 ],
