 "tables": [
  {
   "title": "Direct law — handling",
   "caption": "FCOM DSC-27 direct law.",
   "columns": [
    "Axis",
    "In direct law"
   ],
   "rows": [
    [
     "Pitch",
     "Direct stick-to-elevator; max elevator deflection varies with CG; no automatic trim"
    ],
    [
     "Roll",
     "Direct stick-to-surface; about 30°/s clean, 25°/s with slats extended"
    ],
    [
     "Yaw",
     "Mechanical (rudder pedals); yaw damping and turn coordination lost"
    ],
    [
     "Protections",
     "None; α floor inoperative; overspeed and stall warnings available"
    ]
   ],
   "applies_to": [
    "all"
   ],
   "refs": [
    {
     "book": "FCOM",
     "code": "DSC-27-20-20",
     "page": "P 17/20",
     "pdf": 1628
    }
