 ],
 "background": [
  {
   "text": "The pitch direct law is a direct stick-to-elevator relationship. Maximum elevator deflection is a compromise between controllability with a forward CG and a not-too-sensitive control with an aft CG.",
   "applies_to": [
    "all"
   ],
   "refs": [
    {
     "book": "FCOM",
     "code": "DSC-27-20-20",
     "page": "P 17/20",
     "pdf": 1628
    }
   ]
  },
  {
   "text": "The roll direct law uses only the ailerons and spoilers 4 and 5 to limit roll rate (spoiler 3 replaces a failed spoiler 4; all roll spoilers if the ailerons have failed).",
   "applies_to": [
    "all"
   ],
   "refs": [
    {
     "book": "FCOM",
     "code": "DSC-27-20-20",
     "page": "P 17/20",
     "pdf": 1628
    }
   ]
  },
  {
   "text": "Both pitch trim wheels give mechanical control of the THS and have priority over electrical control. A pilot action on the pitch trim wheel disconnects the autopilot.",
   "applies_to": [
    "all"
   ],
   "refs": [
    {
     "book": "FCOM",
     "code": "DSC-27-20-30",
     "page": "P 2/22",
     "pdf": 1633
    }
   ]
  },
  {
   "text": "The abnormal attitude law also shows F/CTL DIRECT LAW on the ECAM and USE MAN PITCH TRIM on the PFDs.",
   "applies_to": [
    "all"
   ],
   "refs": [
    {
     "book": "FCOM",
     "code": "DSC-27-20-20",
     "page": "P 18/20",
     "pdf": 1629
    }
   ]
  }
 ],
 "technique": [
  {
   "text": "Direct law: be careful with large thrust changes or sudden speedbrake movements, particularly with an aft CG. Retract speedbrakes gently to give time to re-trim. At go-around, TOGA thrust gives a large pitch-up moment — apply nose-down trim to avoid excessive pitch-up or a transient stall warning.",
   "applies_to": [
    "all"
   ],
   "refs": [
    {
     "book": "FCTM",
     "code": "AOP-10-30-20",
     "page": "P 1/2",
     "pdf": 62
    }
   ]
  }
 ],
