 "background": [
  {
   "text": "Three independent Probe Heat Computers automatically control and monitor the captain, F/O and standby probes. They protect against overheating and indicate faults.",
   "applies_to": [
    "all"
   ],
   "refs": [
    {
     "book": "FCOM",
     "code": "DSC-30-50-10",
     "page": "P 1/2",
     "pdf": 1786
    }
   ]
  },
  {
   "text": "Heating protects the pitot probes, static ports, AOA probes and TAT probes.",
   "applies_to": [
    "all"
   ],
   "refs": [
    {
     "book": "FCOM",
     "code": "DSC-30-50-10",
     "page": "P 1/2",
     "pdf": 1786
    }
   ]
  },
  {
   "text": "ADIRU 1 is supplied by the CAPT probes, ADIRU 2 by the F/O probes, and ADIRU 3 by the STBY probes and CAPT TAT.",
   "applies_to": [
    "all"
   ],
   "refs": [
    {
     "book": "FCOM",
     "code": "DSC-34-NAV-10-10",
     "page": "P 3/4",
     "pdf": 2098
    }
   ]
  },
  {
   "text": "With the selector in NORM, ADIRU 1 supplies PFD 1 and ND 1. CAPT 3 replaces ADR 1 with ADR 3.",
   "applies_to": [
    "all"
   ],
   "refs": [
    {
     "book": "FCOM",
     "code": "DSC-34-NAV-10-20",
     "page": "P 3/6",
     "pdf": 2102
    }
   ]
  }
 ],
