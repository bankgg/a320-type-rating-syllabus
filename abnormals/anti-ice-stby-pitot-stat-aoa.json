 "background": [
  {
   "text": "Electrical heating protects pitot probes, static ports, AOA probes and TAT probes. Three independent Probe Heat Computers control the Captain, F/O and STBY probes.",
   "applies_to": [
    "all"
   ],
   "refs": [
    {
     "book": "FCOM",
     "code": "DSC-30-50-10",
     "page": "P 1/2",
     "pdf": 1786
    }
   ]
  },
  {
   "text": "Probes are heated automatically in flight or with one engine running, or manually with PROBE/WINDOW HEAT ON.",
   "applies_to": [
    "all"
   ],
   "refs": [
    {
     "book": "FCOM",
     "code": "DSC-30-50-10",
     "page": "P 1/2",
     "pdf": 1786
    },
    {
     "book": "FCOM",
     "code": "DSC-30-50-20",
     "page": "P 1/2",
     "pdf": 1788
    }
   ]
  },
  {
   "text": "ADR 3 and the standby speed use the same probe; STBY SPD UNCERTAIN appears when ADR 3 speed is declared faulty.",
   "applies_to": [
    "all"
   ],
   "refs": [
    {
     "book": "FCOM",
     "code": "PRO-ABN-NAV",
     "page": "P 3/124",
     "pdf": 3828
    },
    {
     "book": "FCOM",
     "code": "DSC-34-NAV-10-30-20",
     "page": "P 3/8",
     "pdf": 2112
    }
   ]
  }
 ],
