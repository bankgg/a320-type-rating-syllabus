 "background": [
  {
   "text": "Typical causes: uncontrollable fire, smoke/fumes — during taxi, after a rejected takeoff or after landing.",
   "applies_to": [
    "all"
   ],
   "refs": [
    {
     "book": "FCTM",
     "code": "PR-AEP-MISC",
     "page": "P 6/32",
     "pdf": 451
    }
   ]
  },
  {
   "text": "With engines stopped only the right dome light works; on batteries the crew seats must be moved mechanically.",
   "applies_to": [
    "all"
   ],
   "refs": [
    {
     "book": "FCTM",
     "code": "PR-AEP-MISC",
     "page": "P 6/32",
     "pdf": 451
    },
    {
     "book": "FCTM",
     "code": "PR-AEP-MISC",
     "page": "P 7/32",
     "pdf": 452
    }
   ]
  }
 ],
 "technique": [
  {
   "text": "\"CABIN CREW (PA)…ALERT\" tells the cabin the flight crew still controls the situation and prevents an unwanted cabin-initiated evacuation (done in the RTO flow).",
   "applies_to": [
    "all"
   ],
   "refs": [
    {
     "book": "FCTM",
     "code": "PR-AEP-MISC",
     "page": "P 7/32",
     "pdf": 452
    }
   ]
  },
  {
   "text": "ΔP check does not apply after an RTO: at least one automatic pressure system is required for departure.",
   "applies_to": [
    "all"
   ],
   "refs": [
    {
     "book": "FCTM",
     "code": "PR-AEP-MISC",
     "page": "P 7/32",
     "pdf": 452
    }
   ]
  },
  {
   "text": "\"EVACUATION…INITIATE\" = notify cabin crew, press EVAC COMMAND, advise ATC — preferably in this order.",
   "applies_to": [
    "all"
   ],
   "refs": [
    {
     "book": "FCTM",
     "code": "PR-AEP-MISC",
     "page": "P 7/32",
     "pdf": 452
    }
   ]
  },
  {
   "text": "Until the order is given the evacuation can be deferred or cancelled; once ordered it is irreversible.",
   "applies_to": [
    "all"
   ],
   "refs": [
    {
     "book": "FCTM",
     "code": "PR-AEP-MISC",
     "page": "P 7/32",
     "pdf": 452
    }
   ]
  }
 ],
