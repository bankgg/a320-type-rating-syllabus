 "background": [
  {
   "text": "Thrust and engine parameters can stay normal early in a fire — not a reason to delay the procedure.",
   "applies_to": [
    "all"
   ],
   "refs": [
    {
     "book": "FCTM",
     "code": "PR-AEP-ENG",
     "page": "P 18/26",
     "pdf": 419
    }
   ]
  },
  {
   "text": "Discharge agents while the alert and a local warning remain. The FIRE light stays on until the fire is out, even after agent 2.",
   "applies_to": [
    "all"
   ],
   "refs": [
    {
     "book": "FCTM",
     "code": "PR-AEP-ENG",
     "page": "P 18/26",
     "pdf": 419
    }
   ]
  }
 ],
 "technique": [
  {
   "text": "If the alert and local warnings disappear after agent 1 (or 1+2), the fire procedure can be stopped and the remaining ECAM done as usual.",
   "applies_to": [
    "all"
   ],
   "refs": [
    {
     "book": "FCTM",
     "code": "PR-AEP-ENG",
     "page": "P 18/26",
     "pdf": 419
    }
   ]
  },
  {
   "text": "Consider LAND ASAP: land at the nearest airport where a safe landing can be performed.",
   "applies_to": [
    "all"
