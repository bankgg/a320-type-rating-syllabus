 "background": [
  {
   "text": "\"RNP APCH\" corresponds to RNAV(GNSS) approaches and \"RNP AR\" to RNAV(RNP). Both use FINAL APP with V/DEV and XTK deviations.",
   "applies_to": [
    "all"
   ],
   "refs": [
    {
     "book": "FCOM",
     "code": "PRO-SPO-51",
     "page": "P 10/14",
     "pdf": 4609
    },
    {
     "book": "FCOM",
     "code": "PRO-SPO-51",
     "page": "P 12/14",
     "pdf": 4611
    },
    {
     "book": "PDP",
     "code": "3D approach",
     "page": "XFTDN13DAPPRO01",
     "pdf": 246
    }
   ]
  },
  {
   "text": "Minimum equipment to start RNP APCH: one FMGC, one GPS, two IRS, one MCDU, one FD, one PFD on the PF side, two NDs, two FCU channels.",
   "applies_to": [
    "all"
   ],
   "refs": [
    {
     "book": "FCOM",
     "code": "PRO-SPO-51",
     "page": "P 11/14",
     "pdf": 4610
    }
   ]
  },
  {
   "text": "If GPS PRIMARY LOST is displayed, navigation accuracy stays sufficient for RNP operations provided the RNP value is checked or entered and HIGH accuracy is displayed. An RNAV(GNSS) approach, however, requires GPS PRIMARY.",
   "applies_to": [
    "all"
   ],
   "refs": [
    {
     "book": "FCOM",
     "code": "LIM-AFS-10",
     "page": "P 4/8",
     "pdf": 4669
    },
    {
     "book": "FCOM",
     "code": "LIM-AFS-10",
     "page": "P 5/8",
     "pdf": 4670
    }
   ]
  },
  {
   "text": "GPS jamming or spoofing can cause NAV ACCUR DOWNGRAD, GPS PRIMARY LOST and NAV FM/GPS POS DISAGREE.",
   "applies_to": [
    "all"
   ],
   "refs": [
    {
     "book": "FCOM",
     "code": "PRO-NOR-SUP-GPSINT",
     "page": "P 1/18",
     "pdf": 4418
    }
   ]
  }
 ],
 "technique": [
  {
   "text": "If NAV accuracy is LOW before the approach, use TRK FPA, and establish on the final course against navaid raw data.",
   "applies_to": [
    "all"
   ],
   "refs": [
    {
     "book": "FCOM",
     "code": "PRO-NOR-SOP-18-C",
     "page": "P 13/36",
     "pdf": 4248
    },
    {
     "book": "FCTM",
     "code": "PR-NP-SOP-190-GUI",
     "page": "P 24/36",
     "pdf": 293
    }
   ]
  },
  {
   "text": "Monitor the final approach with the blue start-of-descent symbol, FMA, V/DEV, XTK and F-PLN, confirmed by needles and distance/altitude.",
   "applies_to": [
    "all"
   ],
   "refs": [
    {
     "book": "FCTM",
     "code": "PR-NP-SOP-190-GUI",
     "page": "P 21/36",
     "pdf": 290
    }
   ]
  },
  {
   "text": "With one engine inoperative, the bank limit can be below 30° when IAS is below manoeuvring speed; retracting flaps at the usual speeds may affect the turn radius.",
   "applies_to": [
    "all"
   ],
   "refs": [
    {
     "book": "FCTM",
     "code": "PR-NP-SP-30",
     "page": "P 3/4",
     "pdf": 384
    },
    {
     "book": "FCTM",
     "code": "PR-NP-SP-30",
     "page": "P 4/4",
     "pdf": 385
    }
   ]
  }
 ],
