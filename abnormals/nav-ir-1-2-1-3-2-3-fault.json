 "tables": [
  {
   "title": "Law reconfiguration — dual IR",
   "caption": "FCOM flight controls law reconfiguration table (NAV rows), same values for HS-TXA..TXF and HS-TXG..TXU.",
   "columns": [
    "Failure",
    "Pitch law",
    "Protection",
    "Roll",
    "Yaw"
   ],
   "rows": [
    [
     "2 ADR or 2 IR (2nd self detected failed)",
     "ALTN",
     "REDUCED",
     "DIRECT",
     "ALTN"
    ],
