 "status": null,
 "background": [
  {
   "text": "During engine start the ENG EGT OVER LIMIT alert is inhibited; if EGT goes above 635 °C the ENG 1(2) START FAULT [EGT OVERLIMIT] alert triggers instead.",
   "applies_to": [
    "all"
   ],
   "refs": [
    {
     "book": "FCOM",
     "code": "PRO-ABN-ENG",
     "page": "P 127/226",
     "pdf": 3374
    }
   ]
  },
  {
   "text": "The FADEC detects hot start, hung start, stall, failed light-up, low start air pressure and thrust lever not at idle; on ground with N2 below 50 % it closes the HP valve and start valve, turns off ignition and runs a 30 s dry crank to remove fuel vapours.",
   "applies_to": [
    "all"
   ],
   "refs": [
    {
     "book": "FCOM",
     "code": "DSC-70-80-40",
     "page": "P 2/8",
     "pdf": 2735
    }
   ]
  },
  {
   "text": "With residual EGT above 250 °C at start, an auto-crank function motors the engine until EGT is below 250 °C, with no crew message (very hot conditions or turn-arounds under 20 min).",
   "applies_to": [
    "all"
   ],
   "refs": [
    {
     "book": "FCOM",
     "code": "DSC-70-80-40",
     "page": "P 2/8",
     "pdf": 2735
    }
   ]
  },
  {
   "text": "Alert partly inhibited: phase 3 for no light-up, stall, overtemperature, hung start or low air pressure; phase 6 for thrust lever not at idle; phase 9 for no N1 rotation; fully inhibited in phases 4, 5, 7 and 8.",
   "applies_to": [
    "all"
   ],
   "refs": [
    {
     "book": "FCOM",
     "code": "PRO-ABN-ENG",
     "page": "P 186/226",
     "pdf": 3433
    }
   ]
  }
 ],
 "technique": [
  {
   "text": "Engine-start supplementary procedures: read the entire procedure first, then the PM reads the actions and the PF acts on the controls.",
   "applies_to": [
    "all"
   ],
   "refs": [
    {
     "book": "FCTM",
     "code": "AOP-20",
     "page": "P 1/10",
     "pdf": 68
    }
   ]
  },
  {
   "text": "Manual start is recommended after a start aborted for stall, EGT overlimit, LO START AIR PRESS, no N1 rotation or hung start, and when an abort is expected (hot or high airfields, reduced EGT margin, weak ground air, tailwind above 10 kt).",
   "applies_to": [
    "all"
   ],
   "refs": [
    {
     "book": "FCOM",
     "code": "PRO-NOR-SUP-ENG",
     "page": "P 1/18",
     "pdf": 4386
    }
   ]
  },
  {
   "text": "In hot weather (OAT ≥ 40 °C) with residual EGT above 100 °C, dry crank 2 min before a manual start; starting with residual EGT above 250 °C is not recommended.",
   "applies_to": [
    "all"
   ],
   "refs": [
    {
     "book": "FCOM",
     "code": "PRO-NOR-SUP-ENG",
     "page": "P 7/18",
     "pdf": 4392
    }
   ]
  }
 ],
