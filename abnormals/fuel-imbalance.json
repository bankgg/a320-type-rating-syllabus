  "background": [
    {
      "text": "In exceptional conditions (i.e. fuel system failure), the maximum imbalance values may be exceeded without significant effect to the aircraft handling qualities. The aircraft remains fully controllable in all flight phases.",
      "applies_to": [
        "all"
      ],
      "refs": [
        {
          "book": "FCOM",
          "code": "LIM-FUEL",
          "page": "P 3/4",
          "pdf": 4722
        }
      ]
    },
    {
      "text": "The fuel check (FOB + FU against the FOB at departure) must also be performed each time a FUEL IMBALANCE procedure is necessary, before applying it. An abnormally negative value suggests a leak; an abnormally positive value, a fuel quantity overread.",
      "applies_to": [
        "all"
      ],
      "refs": [
        {
          "book": "FCOM",
          "code": "PRO-NOR-SOP-15",
          "page": "P 2/4",
          "pdf": 4199
        }
      ]
    }
  ],
  "technique": [
    {
      "text": "For any message or alert related to the fuel leak, fuel quantity or fuel imbalance, the flight crew should consider a fuel leak as a possible cause.",
      "applies_to": [
        "all"
      ],
      "refs": [
        {
          "book": "FCTM",
          "code": "PR-AEP-FUEL",
          "page": "P 1/4",
          "pdf": 434
        }
      ]
    }
  ],
  "related": [
