 "background": [
  {
   "text": "RNAV 1(2) operations correspond to P-RNAV terminal RNAV; the AIP may specify that GPS is required. RNP 1 operations correspond to RNP 1 terminal operations.",
   "applies_to": [
    "all"
   ],
   "refs": [
    {
     "book": "FCOM",
     "code": "PRO-SPO-51",
     "page": "P 4/14",
     "pdf": 4603
    },
    {
     "book": "FCOM",
     "code": "PRO-SPO-51",
     "page": "P 9/14",
     "pdf": 4608
    }
   ]
  },
  {
   "text": "For RNP 1, RAIM/AIME availability should be confirmed during flight preparation.",
   "applies_to": [
    "all"
   ],
   "refs": [
    {
     "book": "FCOM",
     "code": "PRO-SPO-51",
     "page": "P 9/14",
     "pdf": 4608
    }
   ]
  },
  {
   "text": "If GPS PRIMARY LOST is displayed, navigation accuracy stays sufficient for RNP operations provided the RNP value is checked or entered and HIGH accuracy is displayed.",
   "applies_to": [
    "all"
   ],
   "refs": [
    {
     "book": "FCOM",
     "code": "LIM-AFS-10",
     "page": "P 4/8",
     "pdf": 4669
    },
    {
     "book": "FCOM",
     "code": "LIM-AFS-10",
     "page": "P 5/8",
     "pdf": 4670
    }
   ]
  },
  {
   "text": "GPS jamming or spoofing can cause NAV ACCUR DOWNGRAD, GPS PRIMARY LOST and NAV FM/GPS POS DISAGREE.",
   "applies_to": [
    "all"
   ],
   "refs": [
    {
     "book": "FCOM",
     "code": "PRO-NOR-SUP-GPSINT",
     "page": "P 1/18",
     "pdf": 4418
    }
   ]
  }
 ],
 "technique": [
  {
   "text": "Fly, navigate, communicate in that order: keep a safe flight path first, and start READ & DO actions no lower than 400 ft AGL unless the path is safe.",
   "applies_to": [
    "all"
   ],
   "refs": [
    {
     "book": "FCTM",
     "code": "AOP-30-30",
     "page": "P 1/6",
     "pdf": 82
    }
   ]
  }
 ],
