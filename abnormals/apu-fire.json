 "background": [
  {
   "text": "The APU has one fire extinguisher bottle with two electrically-operated squibs. The flight crew controls the discharge from the FIRE panel in the cockpit.",
   "applies_to": [
    "all"
   ],
   "refs": [
    {
     "book": "FCOM",
     "code": "DSC-26-20-10",
     "page": "P 2/2",
     "pdf": 1531
    }
   ]
  },
  {
   "text": "The APU AGENT pb becomes active when the flight crew releases the APU FIRE pb-sw.",
   "applies_to": [
    "all"
   ],
   "refs": [
    {
     "book": "FCOM",
     "code": "DSC-26-20-20",
     "page": "P 3/6",
     "pdf": 1534
    }
   ]
  },
  {
   "text": "When an APU fire is detected on the ground, the APU automatically shuts down and the bottle discharges automatically, 3 s after the fire warning appears. The red APU FIRE light on the external power panel and an external horn also come on.",
   "applies_to": [
    "all"
   ],
   "refs": [
    {
     "book": "FCOM",
     "code": "DSC-26-20-10",
     "page": "P 2/2",
     "pdf": 1531
    },
    {
     "book": "FCOM",
     "code": "DSC-26-20-20",
     "page": "P 5/6",
     "pdf": 1536
    }
   ]
  }
 ],
