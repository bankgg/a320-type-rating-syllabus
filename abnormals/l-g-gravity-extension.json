 "tables": [],
 "background": [
  {
   "text": "Lever DOWN after gravity extension extinguishes the UNLK lights on the LDG GEAR indicator panel, avoids the L/G CTL message on the WHEEL SD page, and minimizes the risk of gear retraction on the ground if the free-fall system is reset.",
   "applies_to": [
    "all"
   ],
   "refs": [
    {
     "book": "FCOM",
     "code": "PRO-ABN-LG",
     "page": "P 7/30",
     "pdf": 3772
    }
   ]
  },
  {
   "text": "Do not reset the free-fall system: this avoids further fluid loss in a leak, or a possible gear unlock if a gear selector valve is jammed UP. It may be reset on training flights; if the green system is available the reset allows the doors to close. The crew should not reset it on the ground after the flight.",
   "applies_to": [
    "all"
   ],
   "refs": [
    {
     "book": "FCOM",
     "code": "PRO-ABN-LG",
     "page": "P 8/30",
     "pdf": 3773
    }
   ]
  },
  {
   "text": "The display may show the gear doors in the amber transit position, depending on speed.",
   "applies_to": [
    "all"
   ],
   "refs": [
    {
     "book": "FCOM",
     "code": "PRO-ABN-LG",
     "page": "P 8/30",
     "pdf": 3773
    }
   ]
  },
  {
   "text": "With both LGCIUs failed, the gear position indications on the ECAM are lost; the LDG GEAR lights remain if LGCIU 1 is electrically supplied.",
   "applies_to": [
    "all"
   ],
   "refs": [
    {
     "book": "FCOM",
     "code": "PRO-ABN-LG",
     "page": "P 8/30",
     "pdf": 3773
    }
   ]
  },
  {
   "text": "With gear and doors extended, fuel consumption is increased (QRH factor 145 % for all HS-TX).",
   "applies_to": [
    "all"
   ],
   "refs": [
    {
     "book": "QRH",
     "code": "24.02",
     "page": "24.02B",
     "pdf": 217
    },
    {
     "book": "QRH",
     "code": "OPS.04",
     "page": "OPS.04D",
     "pdf": 276
    },
    {
     "book": "QRH",
     "code": "OPS.04",
     "page": "OPS.04F",
     "pdf": 278
    }
   ]
  }
 ],
