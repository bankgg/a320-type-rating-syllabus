 "status": null,
 "background": [
  {
   "text": "In exceptional cases (in-flight turn back or diversion), an immediate landing above maximum landing weight is permitted, provided the pilot follows the overweight landing procedure.",
   "applies_to": [
    "all"
   ],
   "refs": [
    {
     "book": "FCOM",
     "code": "LIM-AG-WGHT",
     "page": "P 1/2",
     "pdf": 4654
    }
   ]
  },
  {
   "text": "Above MLW, structural considerations require the ability to touch down at 360 ft/min without damage.",
   "applies_to": [
    "all"
   ],
   "refs": [
    {
     "book": "FCTM",
     "code": "PR-AEP-MISC",
     "page": "P 16/32",
     "pdf": 461
    }
   ]
  }
 ],
 "technique": [
  {
   "text": "Fly a long straight-in approach or a wide visual pattern to configure early; VAPP at the FAF, VLS at the threshold.",
   "applies_to": [
    "all"
   ],
   "refs": [
    {
     "book": "FCTM",
     "code": "PR-AEP-MISC",
     "page": "P 16/32",
     "pdf": 461
    }
   ]
  },
  {
   "text": "VLS CONF 1+F may be higher than VLS CONF 3 + 5 kt in a CONF 1+F go-around: follow SRS, which accelerates to the displayed VLS.",
   "applies_to": [
    "all"
   ],
   "refs": [
    {
     "book": "FCTM",
     "code": "PR-AEP-MISC",
     "page": "P 16/32",
     "pdf": 461
    }
   ]
  },
  {
   "text": "Modulate braking with the runway available to avoid very hot brakes and tire deflation.",
   "applies_to": [
    "all"
   ],
   "refs": [
    {
     "book": "FCTM",
     "code": "PR-AEP-MISC",
     "page": "P 16/32",
     "pdf": 461
    }
   ]
  }
 ],
