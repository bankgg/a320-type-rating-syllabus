 "background": [
  {
   "text": "Leak detection loops detect overheating near the hot air ducts. A wing has a double loop: a wing leak signal needs both loops, or one loop with the other inoperative.",
   "applies_to": [
    "all"
   ],
   "refs": [
    {
     "book": "FCOM",
     "code": "DSC-36-10-50",
     "page": "P 1/4",
     "pdf": 2352
    }
   ]
  },
  {
   "text": "A wing leak signal closes the bleed valve on the related side, turns on the FAULT light on the AIR COND panel and closes the x-bleed valve (except during an engine start). For a left wing leak, it also closes the APU bleed valve if open (except during an engine start).",
   "applies_to": [
    "all"
   ],
   "refs": [
    {
     "book": "FCOM",
     "code": "DSC-36-10-50",
     "page": "P 1/4",
     "pdf": 2352
    },
    {
     "book": "FCOM",
     "code": "DSC-36-10-30",
     "page": "P 1/2",
     "pdf": 2348
    }
   ]
  },
  {
   "text": "If one BMC fails, the other still issues the wing leak warning, but the associated FAULT light is lost and the associated bleed valve does not close automatically.",
   "applies_to": [
    "all"
   ],
   "refs": [
    {
     "book": "FCOM",
     "code": "DSC-36-10-60",
     "page": "P 1/2",
     "pdf": 2356
    }
   ]
  }
 ],
