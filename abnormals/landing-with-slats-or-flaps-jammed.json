 "gaps": [
  {
   "text": "The QRH and FCOM word two lines differently: \"Recommended speed for diversion\" / \"Recommended diversion speed\", and \"L/G GEAR NOT DOWN\" / \"L/G L/G NOT DOWN\". The QRH wording is used.",
   "applies_to": [
    "all"
   ],
   "refs": [
    {
     "book": "QRH",
     "code": "20.02",
     "page": "20.02C",
