 "flow": [
  {
   "phase": "Recognise and confirm",
   "steps": [
    {
     "actor": "BOTH",
     "items": [
      {
       "kind": "condition",
       "text": "First pilot to observe the divergence",
       "children": [
        {
         "kind": "callout",
         "text": "NOSE HIGH",
         "applies_to": [
          "all"
         ],
         "refs": [
          {
           "book": "FCTM",
           "code": "PR-AEP-MISC",
           "page": "P 29/32",
           "pdf": 474
          },
          {
           "book": "PDP",
           "code": "Unreliable speed indication (and UPRT)",
           "page": "XFTDA6UNRASPD01",
           "pdf": 611
          }
         ]
        },
        {
         "kind": "callout",
         "text": "NOSE LOW",
         "applies_to": [
          "all"
         ],
         "refs": [
          {
           "book": "FCTM",
           "code": "PR-AEP-MISC",
           "page": "P 29/32",
           "pdf": 474
          },
          {
           "book": "PDP",
           "code": "Unreliable speed indication (and UPRT)",
           "page": "XFTDA6UNRASPD01",
           "pdf": 625
          }
         ]
        }
       ],
       "applies_to": [
        "all"
       ],
       "refs": [
        {
         "book": "FCTM",
         "code": "PR-AEP-MISC",
         "page": "P 29/32",
         "pdf": 474
        }
       ]
      },
      {
       "kind": "action",
       "text": "Assess the energy: airspeed, altitude, attitude, load factor, thrust setting, position of drag and high-lift devices, and the rate of change of those conditions",
       "applies_to": [
        "all"
       ],
       "refs": [
        {
         "book": "FCTM",
         "code": "PR-AEP-MISC",
         "page": "P 29/32",
         "pdf": 474
        }
       ]
      },
      {
       "kind": "action",
       "text": "Determine the pitch and bank angle on the PFD, and communicate with the other crew member",
       "applies_to": [
        "all"
       ],
       "refs": [
        {
         "book": "FCTM",
         "code": "PR-AEP-MISC",
         "page": "P 29/32",
         "pdf": 474
        }
       ]
      },
      {
       "kind": "action",
       "text": "Confirm the attitude: nose low, normally airspeed increasing, altitude decreasing, VSI descent; nose high, normally airspeed decreasing, altitude increasing, VSI climb",
       "applies_to": [
        "all"
       ],
       "refs": [
        {
         "book": "FCTM",
         "code": "PR-AEP-MISC",
         "page": "P 29/32",
         "pdf": 474
        }
       ]
      },
      {
       "kind": "action",
       "text": "Check other attitude sources: standby attitude indications, the PM instruments, references outside the cockpit when possible",
       "applies_to": [
        "all"
       ],
       "refs": [
        {
         "book": "FCTM",
         "code": "PR-AEP-MISC",
         "page": "P 30/32",
         "pdf": 475
        }
       ]
      },
      {
       "kind": "condition",
       "text": "If stalled (stall buffet and/or stall aural alert)",
       "children": [
        {
         "kind": "action",
         "text": "Apply the stall recovery procedure first",
         "applies_to": [
          "all"
         ],
         "refs": [
          {
           "book": "FCTM",
           "code": "PR-AEP-MISC",
           "page": "P 29/32",
           "pdf": 474
          },
          {
           "book": "PDP",
           "code": "Unreliable speed indication (and UPRT)",
           "page": "XFTDA6UNRASPD01",
           "pdf": 608
          }
         ]
        }
       ],
       "applies_to": [
        "all"
       ],
       "refs": [
        {
         "book": "FCTM",
         "code": "PR-AEP-MISC",
         "page": "P 29/32",
         "pdf": 474
        }
       ]
      },
      {
       "kind": "note",
       "text": "To avoid dual inputs, know at all times who has control. If the PM wants to act on the sidestick: announce \"I have control\", then press and maintain the sidestick pushbutton",
       "applies_to": [
        "all"
       ],
       "refs": [
        {
         "book": "FCTM",
         "code": "PR-AEP-MISC",
         "page": "P 29/32",
         "pdf": 474
        },
        {
         "book": "FCTM",
         "code": "AOP-10-30-20",
         "page": "P 1/2",
         "pdf": 62
        }
       ]
      }
     ]
    }
   ]
  },
  {
   "phase": "Nose high",
   "steps": [
    {
     "actor": "PF",
     "items": [
      {
       "kind": "action",
       "text": "Takeover and disconnect AP and A/THR",
       "applies_to": [
        "all"
       ],
       "refs": [
        {
         "book": "FCTM",
         "code": "PR-AEP-MISC",
         "page": "P 30/32",
         "pdf": 475
        },
        {
         "book": "PDP",
         "code": "Unreliable speed indication (and UPRT)",
         "page": "XFTDA6UNRASPD01",
         "pdf": 612
        }
       ]
      },
      {
       "kind": "note",
       "text": "If the AP and A/THR responses enable to stop the flight path divergence, the flight crew may keep them engaged",
       "applies_to": [
        "all"
       ],
       "refs": [
        {
         "book": "FCTM",
         "code": "PR-AEP-MISC",
         "page": "P 31/32",
         "pdf": 476
        },
        {
         "book": "PDP",
         "code": "Unreliable speed indication (and UPRT)",
         "page": "XFTDA6UNRASPD01",
         "pdf": 613
        }
       ]
      },
      {
       "kind": "action",
       "text": "Apply nose down pitch order: as much as required to obtain a nose down pitch rate",
       "applies_to": [
        "all"
       ],
       "refs": [
        {
         "book": "FCTM",
         "code": "PR-AEP-MISC",
         "page": "P 30/32",
         "pdf": 475
        },
        {
         "book": "FCTM",
         "code": "PR-AEP-MISC",
         "page": "P 31/32",
         "pdf": 476
        }
       ]
      },
      {
       "kind": "condition",
       "text": "In the case of lack of pitch down authority",
       "children": [
        {
         "kind": "action",
         "text": "Use incremental inputs on the trim (nose down) to improve the effectiveness of the elevator control",
         "applies_to": [
          "all"
         ],
         "refs": [
          {
           "book": "FCTM",
           "code": "PR-AEP-MISC",
           "page": "P 31/32",
           "pdf": 476
          },
          {
           "book": "PDP",
           "code": "Unreliable speed indication (and UPRT)",
           "page": "XFTDA6UNRASPD01",
           "pdf": 615
          }
         ]
        },
        {
         "kind": "note",
         "text": "Excessive use of pitch trim may make the upset situation worse or may result in high structural loads",
         "applies_to": [
          "all"
         ],
         "refs": [
          {
           "book": "FCTM",
           "code": "PR-AEP-MISC",
           "page": "P 30/32",
           "pdf": 475
          },
          {
           "book": "PDP",
           "code": "Unreliable speed indication (and UPRT)",
           "page": "XFTDA6UNRASPD01",
           "pdf": 615
          }
         ]
        }
       ],
       "applies_to": [
        "all"
       ],
       "refs": [
        {
         "book": "FCTM",
         "code": "PR-AEP-MISC",
         "page": "P 31/32",
         "pdf": 476
        }
       ]
      },
      {
       "kind": "action",
       "text": "Adjust the thrust: select up to maximum thrust available while ensuring adequate pitch control",
       "applies_to": [
        "all"
       ],
       "refs": [
        {
         "book": "FCTM",
         "code": "PR-AEP-MISC",
         "page": "P 30/32",
         "pdf": 475
        },
        {
         "book": "FCTM",
         "code": "PR-AEP-MISC",
         "page": "P 31/32",
         "pdf": 476
        }
       ]
      },
      {
       "kind": "note",
       "text": "Increasing thrust may reduce the effectiveness of nose-down pitch control. It may be necessary to limit or reduce thrust to the point where control of the pitch is achieved",
       "applies_to": [
        "all"
       ],
       "refs": [
        {
         "book": "FCTM",
         "code": "PR-AEP-MISC",
         "page": "P 31/32",
         "pdf": 476
        },
        {
         "book": "PDP",
         "code": "Unreliable speed indication (and UPRT)",
         "page": "XFTDA6UNRASPD01",
         "pdf": 617
        }
       ]
      },
      {
       "kind": "action",
       "text": "Adjust the roll not to exceed 60 degrees",
       "applies_to": [
        "all"
       ],
       "refs": [
        {
         "book": "FCTM",
         "code": "PR-AEP-MISC",
         "page": "P 30/32",
         "pdf": 475
        },
        {
         "book": "FCTM",
         "code": "PR-AEP-MISC",
         "page": "P 31/32",
         "pdf": 476
        }
       ]
      },
      {
       "kind": "condition",
       "text": "If all normal pitch control techniques are unsuccessful",
       "children": [
        {
         "kind": "action",
         "text": "Keep the current bank angle or bank the aircraft to enable the nose to drop toward the horizon",
         "applies_to": [
          "all"
         ],
         "refs": [
          {
           "book": "FCTM",
           "code": "PR-AEP-MISC",
           "page": "P 31/32",
           "pdf": 476
          },
          {
           "book": "PDP",
           "code": "Unreliable speed indication (and UPRT)",
           "page": "XFTDA6UNRASPD01",
           "pdf": 619
          }
         ]
        },
        {
         "kind": "note",
         "text": "The least bank possible to start the nose down, never exceeding approximately 60°. If already greater than 60°, reduce it to less than 60°",
         "applies_to": [
          "all"
         ],
         "refs": [
          {
           "book": "FCTM",
           "code": "PR-AEP-MISC",
           "page": "P 31/32",
           "pdf": 476
          },
          {
           "book": "PDP",
           "code": "Unreliable speed indication (and UPRT)",
           "page": "XFTDA6UNRASPD01",
           "pdf": 619
          }
         ]
        }
       ],
       "applies_to": [
        "all"
       ],
       "refs": [
        {
         "book": "FCTM",
         "code": "PR-AEP-MISC",
         "page": "P 31/32",
         "pdf": 476
        }
       ]
      },
      {
       "kind": "action",
       "text": "Recover the level flight",
       "applies_to": [
        "all"
       ],
       "refs": [
        {
         "book": "FCTM",
         "code": "PR-AEP-MISC",
         "page": "P 30/32",
         "pdf": 475
        }
       ]
      },
      {
       "kind": "note",
       "text": "At a sufficient airspeed while avoiding a stall due to premature recovery at low speed, or excessive g-loading at high speed",
       "applies_to": [
        "all"
       ],
       "refs": [
        {
         "book": "FCTM",
         "code": "PR-AEP-MISC",
         "page": "P 31/32",
         "pdf": 476
        },
        {
         "book": "PDP",
         "code": "Unreliable speed indication (and UPRT)",
         "page": "XFTDA6UNRASPD01",
         "pdf": 621
        }
       ]
      }
     ]
    },
    {
     "actor": "PM",
     "items": [
      {
       "kind": "action",
       "text": "Monitor the airspeed and the attitude throughout the recovery",
       "applies_to": [
        "all"
       ],
       "refs": [
        {
         "book": "FCTM",
         "code": "PR-AEP-MISC",
         "page": "P 30/32",
         "pdf": 475
        }
       ]
      },
      {
       "kind": "action",
       "text": "Announce the flight path divergence if the recovery maneuver is not efficient",
       "applies_to": [
        "all"
       ],
       "refs": [
        {
         "book": "FCTM",
         "code": "PR-AEP-MISC",
         "page": "P 30/32",
         "pdf": 475
        }
       ]
      }
     ]
    }
   ]
  },
