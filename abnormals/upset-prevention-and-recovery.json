 "status": null,
 "tables": [
  {
   "title": "Abnormal attitude law",
   "caption": "The law engages when one of these values is reached.",
   "columns": [
    "Parameter",
    "Value"
   ],
   "rows": [
    [
     "Bank angle",
     "Above 125°"
    ],
    [
     "Pitch attitude, if at least 2 ADC are valid and consistent",
     "Above 50° nose up or below 30° nose down"
    ],
    [
     "Pitch attitude, in all other cases",
     "Above 40° nose up or below 20° nose down"
    ],
    [
     "Speed",
     "Below 70 to 90 kt (depending on the aircraft pitch attitude), or above 440 kt"
    ],
    [
     "Mach",
     "Above 0.91"
    ],
    [
     "Angle of attack",
     "Above 40°"
    ]
   ],
   "applies_to": [
    "all"
   ],
   "refs": [
    {
     "book": "FCOM",
     "code": "DSC-27-20-20",
     "page": "P 18/20",
     "pdf": 1629
    }
