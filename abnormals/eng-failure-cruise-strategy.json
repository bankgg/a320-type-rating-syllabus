 "technique": [
  {
   "text": "Engine failure in cruise: unless a dispatch procedure exists, use the standard strategy, M 0.78/300 kt to the REC MAX EO (LRC engine-out ceiling). Obstacle strategy: green dot to the drift-down ceiling, then standard when clear.",
   "applies_to": [
    "all"
   ],
   "refs": [
    {
     "book": "FCTM",
     "code": "PR-AEP-ENG",
     "page": "P 15/26",
     "pdf": 416
    },
    {
     "book": "FCTM",
     "code": "PR-AEP-ENG",
     "page": "P 16/26",
     "pdf": 417
    }
   ]
  },
  {
   "text": "Do not hurry the ECAM actions in cruise — complete the drill correctly.",
   "applies_to": [
    "all"
   ],
   "refs": [
