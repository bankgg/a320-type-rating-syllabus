 "background": [
  {
   "text": "APU GEN pb-sw OFF de-energizes the generator field, opens the line contactor and resets the fault circuit.",
   "applies_to": [
    "all"
   ],
   "refs": [
    {
     "book": "FCOM",
     "code": "DSC-24-20",
     "page": "P 4/22",
     "pdf": 1467
    }
   ]
  },
  {
   "text": "The APU GEN FAULT light is inhibited when APU speed is too low, or when the APU GEN line contactor opens after EXT PWR or an engine generator takes over.",
   "applies_to": [
    "all"
   ],
   "refs": [
    {
     "book": "FCOM",
     "code": "DSC-24-20",
     "page": "P 4/22",
     "pdf": 1467
    }
   ]
  }
 ],
