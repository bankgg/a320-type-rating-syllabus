 "procedures": [
  {
   "title": "Diversion decision making",
   "source": "FCOM PRO-SPO-40-40",
   "lines": [
    {
     "kind": "info",
     "text": "The technical criteria governing a re-routing or diversion decision can be classified into four categories:",
     "level": 0,
     "applies_to": [
      "all"
