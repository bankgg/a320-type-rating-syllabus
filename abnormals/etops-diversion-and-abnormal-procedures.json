     "refs": [
      {
       "book": "FCOM",
       "code": "PRO-SPO-40-40",
       "page": "P 1/2",
       "pdf": 4586
      }
     ]
    },
    {
     "kind": "info",
     "text": "Loss of NAT-HLA capability, before entering the NAT-HLA area (as applicable)",
     "level": 1,
     "applies_to": [
      "all"
     ],
     "refs": [
      {
       "book": "FCOM",
       "code": "PRO-SPO-40-40",
       "page": "P 1/2",
       "pdf": 4586
      }
     ]
    },
    {
     "kind": "info",
     "text": "Weather minima at diversion airport(s) going below the company/crew en-route minima, before reaching the ETOPS Entry Point, or diversion airport(s) becoming unsuitable for any reason",
     "level": 1,
     "applies_to": [
      "all"
     ],
     "refs": [
      {
       "book": "FCOM",
       "code": "PRO-SPO-40-40",
       "page": "P 1/2",
       "pdf": 4586
      }
     ]
    },
    {
     "kind": "info",
     "text": "Failure cases requiring a diversion to the nearest airport (cases leading to a LAND ASAP message on the ECAM and/or in the QRH)",
