 "background": [
  {
   "text": "Causes: dual flaps control unit (SFCC flaps channel) failure, dual hydraulic failure, a combination, a mechanical jam, or locking by wing tip brake activation.",
   "applies_to": [
    "all"
   ],
   "refs": [
    {
     "book": "FCTM",
     "code": "PR-AEP-F_CTL",
     "page": "P 1/6",
     "pdf": 428
    }
   ]
  },
  {
   "text": "Consequences: the control laws may change, the selected speed must be used, an early stabilized approach should be preferred, approach attitudes change, approach speeds and landing distances increase, and the go-around procedure may have to be modified.",
   "applies_to": [
    "all"
   ],
   "refs": [
    {
