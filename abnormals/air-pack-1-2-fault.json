 "background": [
  {
   "text": "Each controller has two lanes. If both lanes fail, the related pack is lost and the hot air pressure-regulating valve closes.",
   "applies_to": [
    "all"
   ],
   "refs": [
    {
     "book": "FCOM",
     "code": "DSC-21-10-40",
     "page": "P 1/2",
     "pdf": 226
    }
   ]
  },
  {
   "text": "RAM AIR pb (guarded): the emergency ram air inlet opens. If Δp ≥ 1 PSI, the outflow valve control remains normal and no emergency ram air flows in. If Δp < 1 PSI, the outflow valve opens to about 50 % under automatic control, and ram air goes directly to the mixer unit.",
   "applies_to": [
    "all"
   ],
   "refs": [
    {
     "book": "FCOM",
     "code": "DSC-21-10-50",
     "page": "P 3/16",
     "pdf": 230
    }
   ]
  }
 ],
 "technique": [
  {
   "text": "ETOPS flights: in the case of loss of the air conditioning capability (loss of both packs, loss of both bleeds without APU bleed, etc.), when at FL 100 with the RAM AIR opened, the CAB FANS must be switched off.",
   "applies_to": [
    "all"
   ],
   "refs": [
    {
     "book": "FCOM",
     "code": "PRO-SPO-40-50",
     "page": "P 2/4",
     "pdf": 4589
    }
   ]
  }
 ],
