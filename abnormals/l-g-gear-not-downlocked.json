 "background": [
  {
   "text": "Lever DOWN after gravity extension extinguishes the UNLK lights, avoids the L/G CTL message and minimises the risk of gear retraction on the ground.",
   "applies_to": [
    "all"
   ],
   "refs": [
    {
     "book": "FCOM",
     "code": "PRO-ABN-LG",
     "page": "P 7/30",
     "pdf": 3772
    }
   ]
  },
  {
   "text": "If both LGCIUs failed, ECAM gear indications are lost; the LDG GEAR panel lights stay if LGCIU 1 is powered. No three green arrows may mean the handcrank is not at its stop.",
   "applies_to": [
    "all"
   ],
   "refs": [
    {
     "book": "FCOM",
     "code": "PRO-ABN-LG",
     "page": "P 8/30",
     "pdf": 3773
    }
   ]
  },
  {
   "text": "Do not reset the free-fall system after a successful gravity extension (fluid loss, possible gear unlock); it may be reset on training flights.",
   "applies_to": [
    "all"
   ],
   "refs": [
    {
     "book": "FCOM",
     "code": "PRO-ABN-LG",
     "page": "P 8/30",
     "pdf": 3773
    }
   ]
  }
 ],
 "technique": [
  {
   "text": "Check the WHEEL SD page and the LDG GEAR DN memo before any gravity extension or abnormal-gear landing: one green triangle on each gear is enough.",
   "applies_to": [
    "all"
   ],
   "refs": [
    {
     "book": "FCTM",
     "code": "PR-AEP-LG",
     "page": "P 1/4",
     "pdf": 442
    }
   ]
  },
  {
   "text": "Landing with abnormal gear: land on any available gear rather than none; reduce weight; no ground spoilers or autobrake with a main gear abnormal; anti-skid off.",
   "applies_to": [
    "all"
   ],
   "refs": [
    {
     "book": "FCTM",
     "code": "PR-AEP-LG",
     "page": "P 1/4",
     "pdf": 442
    }
   ]
  },
  {
   "text": "ENG masters OFF: nose gear abnormal — before nose impact; one main — at touchdown; both mains — in the flare. Fire pbs pushed when the aircraft has stopped.",
   "applies_to": [
    "all"
   ],
   "refs": [
    {
     "book": "FCTM",
     "code": "PR-AEP-LG",
     "page": "P 2/4",
     "pdf": 443
    }
   ]
  }
 ],
