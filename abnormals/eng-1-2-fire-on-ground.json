 "background": [
  {
   "text": "ECAM inhibits non-essential alerts from 80 kt to 1 500 ft (or 2 min after lift-off): any alert in this period is significant.",
   "applies_to": [
    "all"
   ],
   "refs": [
    {
     "book": "FCTM",
     "code": "PR-AEP-MISC",
     "page": "P 18/32",
     "pdf": 463
    }
   ]
  },
  {
   "text": "Above 100 kt and below V1 the Captain is go-minded; a fire alert or severe damage is one of the few reasons to reject.",
   "applies_to": [
    "all"
   ],
   "refs": [
    {
     "book": "FCTM",
     "code": "PR-AEP-MISC",
     "page": "P 19/32",
     "pdf": 464
    }
   ]
  }
 ],
 "technique": [
  {
   "text": "The Captain keeps a hand on the thrust levers until V1, whether PF or PM.",
   "applies_to": [
    "all"
   ],
   "refs": [
    {
     "book": "FCTM",
     "code": "PR-AEP-MISC",
     "page": "P 19/32",
     "pdf": 464
    }
   ]
  },
  {
   "text": "\"STOP\" both confirms the decision and states the Captain has control — the only handover without \"I have control\".",
   "applies_to": [
    "all"
   ],
   "refs": [
    {
     "book": "FCTM",
     "code": "PR-AEP-MISC",
     "page": "P 19/32",
     "pdf": 464
    }
   ]
  },
  {
   "text": "Rejected before 72 kt or autobrake inoperative: reduce thrust and apply full pedal braking until stopped.",
   "applies_to": [
    "all"
   ],
   "refs": [
    {
     "book": "FCTM",
     "code": "PR-AEP-MISC",
     "page": "P 21/32",
     "pdf": 466
    }
   ]
  },
  {
   "text": "After an A/BRK MAX stop, disarm ground spoilers before taxiing; do not vacate until it is clear no evacuation is needed.",
   "applies_to": [
    "all"
   ],
   "refs": [
    {
     "book": "FCTM",
     "code": "PR-AEP-MISC",
     "page": "P 21/32",
     "pdf": 466
    }
   ]
  }
 ],
