 "tables": [],
 "background": [
  {
   "text": "Single mode: the failed FMGC shows OPP FMGC IN PROCESS; its ND shows MAP NOT AVAIL / SET OFFSIDE RNG/MODE, or OFFSIDE FM CONTROL when ranges match.",
   "applies_to": [
    "all"
   ],
   "refs": [
    {
     "book": "FCOM",
     "code": "DSC-22_10-30",
     "page": "P 4/6",
     "pdf": 319
    }
   ]
  },
  {
   "text": "If one FMGC fails, the remaining FMGC controls the radio receivers on both sides; if both fail, use the RMPs.",
   "applies_to": [
    "all"
   ],
   "refs": [
    {
     "book": "FCOM",
     "code": "DSC-34-NAV-30-10",
     "page": "P 1/4",
     "pdf": 2134
    }
   ]
  },
  {
   "text": "BACK UP NAV gives flight planning, position from IRS/GPIRS, F-PLN on ND and sequencing — no AP/FD NAV mode.",
   "applies_to": [
    "all"
   ],
   "refs": [
    {
     "book": "FCOM",
     "code": "DSC-22_10-30",
     "page": "P 5/6",
     "pdf": 320
    }
   ]
  }
 ],
 "technique": [
  {
   "text": "Single failure: recover flight-plan display on the affected ND by using the same range as the opposite ND; consider a reset per QRH.",
   "applies_to": [
    "all"
   ],
   "refs": [
    {
     "book": "FCTM",
     "code": "PR-AEP-AUTOFLT",
     "page": "P 1/2",
     "pdf": 394
    }
   ]
  },
  {
   "text": "Dual failure: if the FG part is still available, the AP may remain engaged and revert to HDG-V/S or TRK-FPA (FG standard dependent).",
   "applies_to": [
    "all"
   ],
   "refs": [
    {
     "book": "FCTM",
     "code": "PR-AEP-AUTOFLT",
     "page": "P 1/2",
     "pdf": 394
    }
   ]
  }
 ],
